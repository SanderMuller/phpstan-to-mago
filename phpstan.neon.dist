includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    tmpDir: .cache/phpstan

    paths:
        - src
        - tests

    # Reviewed output of the transpiler, not hand-written source. Reformatting or "fixing" it would
    # change what the snapshot test compares against.
    excludePaths:
        - tests/Fixtures/expected
        # The differential's example pairs, plus the framework stubs they resolve against. Every `Bad`
        # example is deliberately wrong code — that is what makes a rule fire on it — and the stubs are
        # bodyless declarations. Both are input to the fires-gate, which runs the real mago binary and a
        # real PHPStan over them with only one rule registered. Analysing them here instead reports the
        # wrongness we put there on purpose.
        - tests/Fixtures/examples
        # Fixture rule *packages*, shaped to reproduce how real packages wire their rules — a configured
        # value, a PHPStan service, a value derived in the constructor, one the neon never wires. They are
        # input the transpiler reads, so their shape is dictated by what they must reproduce rather than by
        # what reads well here; a property the fixture deliberately never uses is the fixture working.
        - tests/Fixtures/ConfiguredPackage
        - tests/Fixtures/UnconfiguredPackage
        # The aggregate differential's project and the plugin that runs over it. The project is deliberately
        # untyped — that is what gives it a coverage percentage to compare — and the plugin is emitted-shaped
        # source, not ours to tidy.
        - tests/Fixtures/aggregate
        # A fixture package whose rule writes a file instead of reporting, which is what makes it a fixture.
        - tests/Fixtures/WriterPackage
        # One function-like per inferred-type shape, plus the two probes that render them. Being deliberately
        # loose is the fixture: an untyped `array` parameter and a docblock-only intersection are two of the
        # shapes being measured, so typing them would remove the rows.
        - tests/Fixtures/types
        # Three classes and a probe over them. One extends a class nothing declares, and being
        # unresolvable is the whole fixture: it is what makes the *cannot tell* state observable.
        - tests/Fixtures/hierarchy
        # A configuration value object whose getters sit deliberately just outside the shape the transpiler
        # recognises — a loose `==`, a populated literal, an argument that decides the key. Being wrong in
        # those specific ways is the fixture: it is input the transpiler reads, and each near miss proves a
        # recognition condition is load-bearing.
        - tests/Fixtures/Configurations/DerivingConfiguration.php
        # Calls a helper nothing in its hierarchy declares. Being invalid is the whole fixture: it proves
        # the transpiler refuses such a call by name instead of translating it into something plausible.
        - tests/Fixtures/Rules/MissingHelperRule.php
        # Three fixtures written with the loose `in_array()`, which this project's own strict rules forbid.
        # Using the loose form is the whole fixture: one proves the transpiler translates it where `==` and
        # `===` provably agree, and the other two prove it refuses where they do not.
        - tests/Fixtures/Rules/LooseNameSetRule.php
        - tests/Fixtures/Rules/LooseNumericNameSetRule.php
        - tests/Fixtures/Rules/LooseTraitNameSetRule.php
        # Anchors a finding on a loop item and returns it from outside the loop. Being wrong is the fixture: it
        # proves the transpiler refuses that instead of emitting a report on whatever PHP left in the variable.
        - tests/Fixtures/Rules/AnchorEscapesLoopRule.php
        # Written with `instanceof ConstantStringType`, which PHPStan deprecates in favour of
        # `Type::getConstantStrings()`. Using the deprecated form is the fixture: three corpus rules write it,
        # and the shape being translated is the `?ClassReflection` helper around it.
        - tests/Fixtures/Rules/ReflectedMockedClassRule.php

    level: max

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    type_perfect:
        null_over_false: true
        narrow_return: true

    cognitive_complexity:
        class: 80
        function: 20

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
        # Pest's expectation API is marked @internal but is the intended public
        # surface for tests. Allow calling it from our tests/.
        -
            identifier: method.internalClass
            paths:
                - tests/*
            reportUnmatched: false
        # The fires-gate has to start the real mago binary and a real PHPStan: the whole point is that a
        # transpiled rule *ran*, which no in-process check can establish. Discovery is the same argument for
        # the same reason: which rules a project registers is a question only that project's own PHPStan can
        # answer, and answering it means running it. Analysing the generated plugins is a third: they are
        # excluded from this config on purpose, so the only way to check them is a second PHPStan run.
        # Scoped to those callers.
        -
            message: '#Calling proc_open\(\) is forbidden#'
            paths:
                - src/RegisteredRules.php
                - tests/Support/CorpusDifferential.php
                - tests/Support/CoverageControl.php
                - tests/Support/CoverageCorpus.php
                - tests/Support/CoverageSetDiff.php
                - tests/Support/TypeDescriptions.php
                - tests/Support/HierarchyKnowledge.php
                - tests/Support/FiresGate.php
                - tests/Unit/AggregatesTypeCoverageTest.php
                - tests/Unit/AnalysesTheEmittedPluginsTest.php
            reportUnmatched: false
