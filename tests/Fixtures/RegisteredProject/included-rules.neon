# Registered twice on purpose, once through `rules:` and once as a service of its own. That is what a
# project gets when two included configs each register the same rule class, and the two are separate
# services with separate arguments rather than one rule.
rules:
    - Sandermuller\PhpstanToMago\Tests\Fixtures\RegisteredRulePackage\DiscoveredRule

services:
    -
        class: Sandermuller\PhpstanToMago\Tests\Fixtures\RegisteredRulePackage\DiscoveredRule
        tags:
            - phpstan.rules.rule

    # Registered and configured by this project, because no package neon names it. The two arguments are
    # deliberately different shapes: one promoted and readable as a property, one not promoted and readable
    # only as the table the constructor derived from it.
    -
        class: Sandermuller\PhpstanToMago\Tests\Fixtures\RegisteredRulePackage\ConfiguredByTheProjectRule
        arguments:
            banned: ['dump', 'dd']
            alsoBanned: ['VarDump', 'Ray']
        tags:
            - phpstan.rules.rule
